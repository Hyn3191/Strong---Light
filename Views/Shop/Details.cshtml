@model S_L.Models.Product
@using System.Collections.Generic

@{
    ViewBag.Title = Model.ProductName;
    var reviews = ViewBag.Reviews as List<S_L.Models.Review>;
}

<div class="details-container">

    <div class="details-image">

        @if (!String.IsNullOrEmpty(Model.Image))
        {
            <img src="@Url.Content(Model.Image)"
                 alt="@Model.ProductName"
                 onerror="this.style.display='none';" />
        }

    </div>

    <div class="details-information">

        <span class="details-category">
            @Model.Category
        </span>

        <h1>@Model.ProductName</h1>

        <h2>₱@Model.Price.ToString("N2")</h2>

        <div class="details-rating">
            @if (Model.ReviewCount > 0)
            {
                <span>★ @Model.AverageRating.ToString("0.0") / 5</span>
                <span>(@Model.ReviewCount Reviews)</span>
            }
            else
            {
                <span>No ratings yet</span>
            }
        </div>

        <p class="details-description">
            @Model.Description
        </p>

        <p>
            <strong>Availability:</strong>

            @if (Model.Stock > 0)
            {
                <span class="available">In Stock (@Model.Stock)</span>
            }
            else
            {
                <span class="unavailable">Out of Stock</span>
            }
        </p>

        @if (Model.Stock > 0)
        {
            <a href="@Url.Action("Add", "Cart", new { id = Model.ProductID })"
               class="add-cart-button">
                🛒 Add to Cart
            </a>
        }
        else
        {
            <button disabled class="out-of-stock-button">
                Out of Stock
            </button>
        }

        <a href="@Url.Action("Index", "Shop")"
           class="back-button">
            Back to Shop
        </a>

    </div>

</div>

<!-- CUSTOMER REVIEWS SECTION -->

<div class="reviews-section">

    <h2>Customer Reviews & Ratings</h2>

    @if (TempData["ReviewMessage"] != null)
    {
        <div class="review-message">
            @TempData["ReviewMessage"]
        </div>
    }

    <!-- REVIEW FORM -->

    <div class="review-form">

        <h3>Share Your Experience</h3>

        @if (Session["Email"] != null)
        {
            using (Html.BeginForm("Submit", "Review", FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="productId"
                       value="@Model.ProductID" />

                <label>Your Rating</label>

                <div class="rating-select">
                    <select name="rating" required>
                        <option value="">Choose your rating</option>
                        <option value="5">★★★★★ - Excellent</option>
                        <option value="4">★★★★ - Very Good</option>
                        <option value="3">★★★ - Good</option>
                        <option value="2">★★ - Fair</option>
                        <option value="1">★ - Poor</option>
                    </select>
                </div>

                <label>Your Review</label>

                <textarea name="comment"
                          rows="5"
                          maxlength="1000"
                          required
                          placeholder="Tell us what you think about this fragrance..."></textarea>

                <button type="submit" class="submit-review">
                    Submit Review
                </button>
            }
        }
        else
        {
            <p>You must log in before submitting a review.</p>

            <a href="@Url.Action("Login", "Account")"
               class="login-review-button">
                Login to Review
            </a>
        }

    </div>

    <!-- DISPLAY CUSTOMER REVIEWS -->

    <div class="customer-reviews">

        <h3>What Our Customers Say</h3>

        @if (reviews != null && reviews.Count > 0)
        {
            foreach (var review in reviews)
            {
                <div class="review-card">

                    <div class="review-header">

                        <h4>@review.CustomerName</h4>

                        <span class="review-date">
                            @review.ReviewDate.ToString("MMMM dd, yyyy")
                        </span>

                    </div>

                    <div class="review-stars">

                        @for (int i = 1; i <= 5; i++)
                        {
                            if (i <= review.Rating)
                            {
                                <span>★</span>
                            }
                            else
                            {
                                <span class="empty-star">★</span>
                            }
                        }

                    </div>

                    <p>@review.Comment</p>

                </div>
            }
        }
        else
        {
            <div class="no-reviews">
                <h4>No reviews yet.</h4>
                <p>Be the first to share your experience!</p>
            </div>
        }

    </div>

</div>

<style>

    /* PRODUCT DETAILS */

    .details-container {
        max-width: 1100px;
        margin: 60px auto;
        padding: 20px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 50px;
        align-items: center;
    }

    .details-image {
        background: #f2f2f2;
        height: 430px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
    }

        .details-image img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 10px;
        }

    .details-category {
        color: #a87932;
        text-transform: uppercase;
    }

    .details-information h1 {
        font-size: 36px;
        margin: 15px 0;
    }

    .details-information h2 {
        color: #a87932;
        font-size: 28px;
    }

    .details-rating {
        color: #d49b35;
        margin: 15px 0;
    }

    .details-description {
        color: #666;
        line-height: 1.8;
        margin: 25px 0;
    }

    .available {
        color: green;
    }

    .unavailable {
        color: red;
    }

    .add-cart-button {
        display: inline-block;
        background: #a87932;
        color: white;
        padding: 13px 25px;
        border-radius: 5px;
        text-decoration: none;
        margin-top: 20px;
    }

        .add-cart-button:hover {
            background: #171717;
            color: white;
            text-decoration: none;
        }

    .out-of-stock-button {
        background: #999;
        color: white;
        padding: 13px 25px;
        border: none;
        margin-top: 20px;
    }

    .back-button {
        display: inline-block;
        background: #171717;
        color: white;
        padding: 13px 25px;
        border-radius: 5px;
        text-decoration: none;
        margin-top: 20px;
    }

        .back-button:hover {
            background: #a87932;
            color: white;
            text-decoration: none;
        }

    /* REVIEWS SECTION */

    .reviews-section {
        max-width: 1100px;
        margin: 60px auto;
        padding: 30px 20px;
        border-top: 1px solid #ddd;
    }

        .reviews-section > h2 {
            font-size: 30px;
            margin-bottom: 30px;
        }

    .review-form {
        background: #f7f7f7;
        padding: 30px;
        border-radius: 10px;
        margin-bottom: 40px;
    }

        .review-form h3 {
            margin-bottom: 20px;
        }

        .review-form label {
            display: block;
            font-weight: bold;
            margin-top: 20px;
            margin-bottom: 10px;
        }

        .review-form select,
        .review-form textarea {
            width: 100%;
            padding: 12px;
            border: 1px solid #ddd;
            border-radius: 5px;
            box-sizing: border-box;
            font-family: Arial;
        }

        .review-form textarea {
            resize: vertical;
        }

    .submit-review {
        display: inline-block;
        margin-top: 20px;
        padding: 13px 25px;
        background: #171717;
        color: white;
        border: none;
        border-radius: 5px;
        cursor: pointer;
    }

        .submit-review:hover {
            background: #a87932;
        }

    .login-review-button {
        display: inline-block;
        background: #171717;
        color: white;
        padding: 12px 20px;
        text-decoration: none;
        border-radius: 5px;
    }

        .login-review-button:hover {
            background: #a87932;
            color: white;
        }

    /* CUSTOMER REVIEW CARDS */

    .customer-reviews h3 {
        margin-bottom: 20px;
    }

    .review-card {
        background: #fff;
        border: 1px solid #eee;
        padding: 25px;
        margin-bottom: 15px;
        border-radius: 8px;
    }

    .review-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
    }

        .review-header h4 {
            margin: 0;
        }

    .review-date {
        color: #999;
        font-size: 13px;
    }

    .review-stars {
        color: #d49b35;
        font-size: 22px;
        margin: 10px 0;
    }

    .empty-star {
        color: #ddd;
    }

    .review-card p {
        color: #555;
        line-height: 1.7;
    }

    .no-reviews {
        background: #f7f7f7;
        padding: 30px;
        text-align: center;
        border-radius: 8px;
    }

    .review-message {
        background: #fff3cd;
        color: #856404;
        padding: 15px;
        border-radius: 5px;
        margin-bottom: 20px;
    }

    @@media (max-width: 700px) {
        .details-container {
            grid-template-columns: 1fr;
        }

        .review-header {
            gap: 10px;
        }
    }
</style>